# Ọmọ Kọ́dà runtime environment — TEMPLATE.
#
# Copy to `.env` and set real values, or export these in the process
# environment / systemd unit that runs the node. Nothing here is a secret by
# default — VANTAGE_KEY is the only sensitive value and is optional.

# ── Vantage integration (social hub) ──────────────────────────────────────────
# Auto-registration on birth is FAIL-OPEN: it is a complete no-op unless
# VANTAGE_URL is set. Set it to the running Vantage backend to have every
# newborn agent self-register (POST /api/agents/register) and join its home
# block (POST /api/mesh/agents/join) with verifiable sovereign identity.
# See omokoda-core/src/tools/mesh_tools.rs (register_newborn).
VANTAGE_URL=http://localhost:8001
# Optional pre-provisioned agent key. Leave empty to let each agent self-register
# and mint + persist its own key at birth (the sovereign default).
VANTAGE_KEY=
# The block a newborn joins on the Vantage mesh.
MESH_BLOCK_ID=default

# ── Node identity / mesh (omokoda-ops) ────────────────────────────────────────
# AGENT_ID=
# SELF_ADDR=
# STEWARD_URL=

# ── ZÀNGBÉTÒ enforcement bridge ───────────────────────────────────────────────
# Behavioral enforcement daemon. Fail-open: when unset every review_act call
# returns None and all tool calls are permitted regardless of severity.
# Set to the running Zangbeto server in production to activate enforcement.
# See: omokoda-core/src/bus/zangbeto.rs (base_url / report_anomaly / review_act)
ZANGBETO_URL=http://localhost:8787

# ── Walrus decentralised storage ─────────────────────────────────────────────
# Used by memory/walrus.rs and tools/walrus_tool.rs for agent memory blobs.
# Fail-open: both vars must be set to activate; unset = walrus disabled.
# Testnet endpoints (public, no auth):
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# ── Seal private memory (MystenLabs threshold encryption) ────────────────────
# Used by memory/seal_bridge.rs to gate private memory blobs.
# Fail-open: unset = seal disabled (blobs stored unencrypted via walrus).
# SEAL_REQUEST_CMD builds + signs the FetchKeyRequest; SEAL_FETCH_CMD retrieves it.
SEAL_REQUEST_CMD=seal-cli request-keys --object-id $SEAL_OBJECT_ID
SEAL_FETCH_CMD=seal-cli fetch-keys --object-id $SEAL_OBJECT_ID
SEAL_KEY_SERVER_IDS=
SEAL_THRESHOLD=2
SEAL_NETWORK=testnet

# ── TEE / Trusted Execution Environment ──────────────────────────────────────
# Used by memory/tee.rs for hardware-attested memory sealing.
# Fail-open: unset = TEE disabled.
TEE_URL=
TEE_ATTESTATION_KEY=

# ── OSOVM execution bridge ────────────────────────────────────────────────────
# See: organism-core/bridge/rlm-osovm.ts and omokoda-core tools/osovm_tool.rs
# Port 7780 is the canonical OSOVM server.jl port.
OSOVM_URL=http://localhost:7780

# ── Chain identity ────────────────────────────────────────────────────────────
# Parameterize from CHAIN_ID instead of hardcoding "testnet" (E-08 fix).
CHAIN_ID=testnet

# ── UCX / GPU compute exchange ───────────────────────────────────────────────
# See: ~/UCX/crates/ucx-broker/src/mint_allowlist.rs
GPUAI_API_KEY=
UCX_BROKER_URL=http://localhost:7790

# ── Waggle swarm coordination ─────────────────────────────────────────────────
# See: omokoda-core/src/waggle/mod.rs
WAGGLE_URL=http://127.0.0.1:7777

# ── Agent phone transport ─────────────────────────────────────────────────────
# See: Vantage/backend/agent_phone_client.py
AGENT_PHONE_URL=http://localhost:8765
