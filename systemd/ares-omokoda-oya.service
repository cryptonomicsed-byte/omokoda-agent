[Unit]
Description=OBSOLETE: ares-omokoda-oya — Go flow/rhythm service (archived; superseded by Rust)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ares/Omo-Koda2/omokoda-go
Environment=OYA_HTTP_PORT=8100
